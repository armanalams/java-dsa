class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        // Base case: If the current node is null, no path exists
        if (root == null) {
            return false;
        }
        
        // If it's a leaf node, check if the remaining targetSum matches its value
        if (root.left == null && root.right == null) {
            return targetSum == root.val;
        }
        
        // Subtract the current node's value and recursively check left and right subtrees
        int remainingSum = targetSum - root.val;
        return hasPathSum(root.left, remainingSum) || hasPathSum(root.right, remainingSum);
    }
}
