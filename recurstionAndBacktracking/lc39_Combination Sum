class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target ) {
         List<List<Integer>> result=new ArrayList<>();

        backtracking(candidates, target, result, new ArrayList<>(), 0, 0);
        return result;
    }
   public static void  backtracking(int[] candidates, int target, List<List<Integer>> result, List<Integer>current, int idx, int count)
    {

       
        if(idx==candidates.length || count>target)
        {
            return;
        }
        {

       

            if(count == target )
            {
                result.add(new ArrayList<>(current));

                return;
            }

             current.add(candidates[idx]);

            
            
            backtracking(candidates,target, result, current, idx ,  count+candidates[idx]);
            current.remove(current.size()-1);
            backtracking(candidates,target, result, current, idx+1 , count);
            

        }
    }
    
}
