class Solution {
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        List<List<Integer>>ans=new ArrayList<>();
        Arrays.sort(nums);
        subset(nums,0,ans,new ArrayList<Integer>());

        return ans;
    }

    public void subset(int nums[], int i, List<List<Integer>>ans, List<Integer>current)
    {
        if(i==nums.length)
    {
        ans.add(new ArrayList<>(current));
        return;
    }
        current.add(nums[i]);
        subset(nums, i+1, ans, current);
        int idx = i+1;
         current.remove(current.size()-1);
        while(idx<nums.length && nums[idx]==nums[idx-1]) idx++;
            subset(nums, idx, ans, current);
    }

}
