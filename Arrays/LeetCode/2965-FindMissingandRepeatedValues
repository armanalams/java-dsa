class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        
        HashMap<Integer, Integer> hm = new HashMap<>();

        int n = grid.length;

        // Frequency count
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (hm.containsKey(grid[i][j])) {
                    hm.put(grid[i][j], hm.get(grid[i][j]) + 1);
                } else {
                    hm.put(grid[i][j], 1);
                }
            }
        }

        int repeated = 0;
        int missing = 0;

        // Find repeated and missing
        for (int i = 1; i <= n * n; i++) {
            if (!hm.containsKey(i)) {
                missing = i;
            } else if (hm.get(i) == 2) {
                repeated = i;
            }
        }

        return new int[]{repeated, missing};
    }
}
